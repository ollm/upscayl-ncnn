+
+    const char* cursor = names;
+    while (*cursor)
+    {
+        while (*cursor == ',' || *cursor == ' ' || *cursor == '\t')
+            cursor++;
+
+        const char* end = cursor;
+        while (*end && *end != ',')
+            end++;
+
+        const size_t length = end - cursor;
+        if (length == layer_name.size() && strncmp(cursor, layer_name.c_str(), length) == 0)
+            return true;
+
+        cursor = end;
+    }
+
+    return false;
+}
