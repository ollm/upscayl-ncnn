+                    Mat host_bottom;
+                    if (blob_mats_gpu[bottom].dims != 0)
+                    {
+                        cmd.record_clone(blob_mats_gpu[bottom], host_bottom, opt);
+                        const int submit_ret = cmd.submit_and_wait();
+                        const int reset_ret = cmd.reset();
+                        if (submit_ret != 0 || reset_ret != 0)
+                        {
+                            fprintf(stderr,
+                                    "[NCNN-LAYER-TRACE] failed to read input blob=%d for dump (submit=%d reset=%d)\n",
+                                    bottom, submit_ret, reset_ret);
+                            continue;
+                        }
+                    }
+                    else
+                    {
+                        host_bottom = blob_mats[bottom];
+                    }
+
+                    char role[32];
+                    snprintf(role, sizeof(role), "input-%zu", bi);
+                    dump_layer_trace_mat(host_bottom, dump_directory, layer_index, bottom, role);
+                }
+                dump_layer_trace_mat(host_tops[i], dump_directory, layer_index, top, "output");
+            }
+            fprintf(stderr, "[NCNN-LAYER-TRACE] layer inputs:");
+            for (size_t bi = 0; bi < layer->bottoms.size(); bi++)
+            {
+                const int bottom = layer->bottoms[bi];
+                if (bottom < 0 || bottom >= (int)blobs.size())
+                    continue;
+#if NCNN_STRING
+                fprintf(stderr, " %s(index=%d)", blobs[bottom].name.c_str(), bottom);
+#else
+                fprintf(stderr, " %d", bottom);
+#endif
+            }
+            fprintf(stderr, "\n");
+            layer_trace_reported_first_nonfinite = true;
+        }
+    }
+}
