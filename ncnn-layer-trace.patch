+        return default_activation;
+    if (strcmp(value, "none") == 0)
+        return 0;
+    if (strcmp(value, "relu") == 0)
+        return 1;
+    if (strcmp(value, "mish-safe") == 0)
+        return 7;
+
+    fprintf(stderr,
+            "[NCNN-LAYER-TRACE] invalid %s='%s' for layer='%s'; expected mish, mish-safe, none or relu\n",
+            variable_name, value, layer_name.c_str());
+    return default_activation;
+}
